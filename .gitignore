__pycache__/
*.pyc
*.pyo
.env
venv/
.venv/
*.egg-info/
dist/
build/
.DS_Store
# Large, fully-regenerable datasets (recreate by running the data + feature scripts)
data/synthea/*.csv
data/wearable/*.csv
data/processed/*.csv

# Ignore processed JSON by default, but KEEP the trained models, metrics, and
# feature metadata so the API/dashboard run out-of-the-box and judges can verify
# the reported results without retraining.
data/processed/*.json
!data/processed/evaluation_results.json
!data/processed/feature_names.json
!data/processed/split_info.json
!data/processed/xgb_fused_regressor.json
!data/processed/xgb_fused_classifier.json
# Real-world validation artifacts (small; keep so results are verifiable)
!data/processed/real_world_results.json
!data/processed/real_world_trained_results.json
!data/processed/clinical_metrics_real.json
!data/processed/xgb_real_regressor.json
!data/processed/xgb_real_classifier.json

# Raw third-party real dataset: not redistributed in-repo; fetch via
# scripts/download_shanghai.py (ShanghaiT2DM, figshare, open for research).
data/real_shanghai/

*.joblib
*.pkl
node_modules/

# Internal agent review artifacts
.agents/
